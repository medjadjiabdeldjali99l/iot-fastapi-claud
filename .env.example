APP_NAME=IoT Cadence Backend
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

YOLO_DEFAULT_MODEL=yolov8n
YOLO_DEFAULT_CONFIDENCE=0.5

# Moteur de détection : "yolo" (réseau, précis, lourd) ou "opencv" (vision
# classique MOG2+contours, léger/temps réel sur Pi). Bascule sans recompiler.
DETECTOR_BACKEND=yolo

# Réglages OpenCV (ignorés si DETECTOR_BACKEND=yolo) :
OPENCV_MIN_AREA=500
OPENCV_MAX_AREA=0
OPENCV_MOG2_HISTORY=500
OPENCV_MOG2_VAR_THRESHOLD=16.0
OPENCV_MOG2_DETECT_SHADOWS=true
OPENCV_TRACK_MAX_DISAPPEARED=30
OPENCV_TRACK_MAX_DISTANCE=80.0

ANOMALY_THRESHOLD_PCT=15.0
CAMERA_PING_TIMEOUT_SECONDS=3.0
